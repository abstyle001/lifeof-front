{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Minimal permissions for the LifeOS main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        {
          "url": "https://lifeos-back.vercel.app/**"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/abstyle001/lifeof-front/**"
        }
      ]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
